{
  "name": "@captain/firebase-transport",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./host": "./src/host.ts",
    "./controller": "./src/controller.ts",
    "./leaderboard": "./src/leaderboard.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests --exclude \"**/*.rules.test.ts\"",
    "test:rules": "firebase emulators:exec --project demo-captain-shootout --only database,firestore --config ../../firebase.json \"vitest run rules\""
  },
  "dependencies": {
    "@captain/game-protocol": "workspace:*",
    "firebase": "^13.2.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/node": "^24.19.2",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
