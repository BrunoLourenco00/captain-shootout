rules_version = '2';

// Kiosk account (Email/Password provider) used by the booth desktop.
// Keep in sync with docs/FIREBASE_SETUP.md.
function isKiosk() {
  return request.auth != null && request.auth.token.email == 'main@trycaptain.app';
}

service cloud.firestore {
  match /databases/{database}/documents {
    match /leaderboard/{key} {
      allow read: if true;
      allow write: if isKiosk()
        && request.resource.data.keys().hasOnly(['key', 'nickname', 'score', 'baskets', 'shots', 'completedAt'])
        && request.resource.data.key == key
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() >= 2
        && request.resource.data.nickname.size() <= 16
        && request.resource.data.score is int && request.resource.data.score >= 0
        && request.resource.data.baskets is int && request.resource.data.baskets >= 0
        && request.resource.data.shots is int && request.resource.data.shots >= request.resource.data.baskets
        && request.resource.data.completedAt is int;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
