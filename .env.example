# Copy to apps/game-desktop/.env.local and apps/controller-mobile/.env.local

# Public URL of the mobile controller (encoded in the QR code).
# Event: https://challenge.trycaptain.app  — fallback: https://<project>.web.app
VITE_CONTROLLER_BASE_URL=http://localhost:5174

# Firebase web config (Phase 3). Web API keys are not secrets, but keep real values out of git.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# CAPTAIN accounts (the CAPTAIN app's own Firebase project, not the game's). Players sign in
# on the phone to make the leaderboard; guests play unranked. Public web config, the same
# values as captain_website/frontend/src/lib/firebase.js.
# Phone: all four. Desktop: only the project id (it verifies the account's ID token).
# Leave empty to run without accounts (everyone is a guest).
VITE_CAPTAIN_FIREBASE_API_KEY=
VITE_CAPTAIN_FIREBASE_AUTH_DOMAIN=captain-app23.firebaseapp.com
VITE_CAPTAIN_FIREBASE_PROJECT_ID=captain-app23
VITE_CAPTAIN_FIREBASE_APP_ID=

# Desktop only (apps/game-desktop/.env.local): kiosk account allowed to write the
# leaderboard (firebase/firestore.rules). The desktop runs locally on the kiosk only;
# never deploy it to a public host with these values.
VITE_KIOSK_EMAIL=main@trycaptain.app
# Quote values with # or $ in them: an unquoted # starts a comment.
VITE_KIOSK_PASSWORD='change-me'
